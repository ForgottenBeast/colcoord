{
  "manifest_version": 2,
  "name": "Colonist-assistant",
  "version": "0.1.2",
  "description": "Automatically join games on colonists.io",
  "icons": {
    "48": "icons/favicon.png"
  },
  "permissions": ["storage", "alarms", "tabs","*://*.colonist.io/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Colonist Assistant"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "colonist-assistant@fb.dev",
      "strict_min_version": "102.0",
      "data_collection_permissions": {
          "required": ["none"]
      }
    }
  }
}
