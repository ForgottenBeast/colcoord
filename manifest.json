{
  "manifest_version": 3,
  "name": "Colonist-assistant",
  "version": "0.0.1",

  "description": "Automatically join games on colonists.io",

  "icons": {
    "48": "favicon.png"
  },
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["*://*.colonists.io/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Colonist Assistant"
  }
}
