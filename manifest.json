{
  "manifest_version": 2,
  "name": "Colonist-assistant",
  "version": "0.0.1",
  "description": "Automatically join games on colonists.io",
  "icons": {
    "48": "icons/favicon.png"
  },
  "permissions": ["storage", "alarms", "tabs","*://*.colonist.io/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Colonist Assistant"
  }
}
